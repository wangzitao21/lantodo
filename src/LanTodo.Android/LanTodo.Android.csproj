<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework><OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>app.lantodo.local</ApplicationId><ApplicationVersion>6</ApplicationVersion><ApplicationDisplayVersion>$(InformationalVersion)</ApplicationDisplayVersion>
    <!-- Android requires an increasing integer build code to upgrade existing installations. -->
    <ApplicationTitle>LanTodo</ApplicationTitle><AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed><RunAOTCompilation>false</RunAOTCompilation>
    <!-- The .NET 10 native marshal registration path produced an unbound MainActivity.n_onCreate in the published APK. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../LanTodo.Core/LanTodo.Core.csproj" /></ItemGroup>
</Project>
