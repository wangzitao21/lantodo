<Window x:Class="LanTodo.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LanTodo.Windows" Style="{StaticResource {x:Type Window}}" Title="LanTodo" Width="1120" Height="780" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#192F3C" Padding="20,30">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="10,0,0,40"><Image Source="{StaticResource BrandMark}" Width="44" Height="44" AutomationProperties.Name="LanTodo 图标"/><StackPanel Margin="12,0,0,0"><TextBlock Text="LanTodo" Foreground="White" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="让想法，轻轻落地" Foreground="#8FA7B4" FontSize="11"/></StackPanel></StackPanel>
          <TextBlock Text="我的空间" Foreground="#6F8A9A" FontSize="11" Margin="18,0,0,10"/>
          <Button x:Name="AllButton" Content="☷     全部清单" Style="{StaticResource Nav}" Click="All_Click"/>
          <Button x:Name="TodayButton" Content="◷     今日安排" Style="{StaticResource Nav}" Click="Today_Click"/>
          <Button x:Name="DoneButton" Content="✓     已完成" Style="{StaticResource Nav}" Click="Done_Click"/>
          <Button x:Name="ConflictsButton" Content="◇     待确认" Style="{StaticResource Nav}" Click="Conflicts_Click"/>
          <Border Height="1" Background="#2D4351" Margin="16,24"/>
          <Button Content="⇄     设备与同步" Style="{StaticResource Nav}" Click="Devices_Click"/>
          <Button Content="▧     备份与恢复" Style="{StaticResource Nav}" Click="Backup_Click"/>
        </StackPanel>
        <StackPanel x:Name="SidebarHint" VerticalAlignment="Bottom" Margin="12,0,6,2"><TextBlock Text="属于你的每一个想法" Foreground="#C1D1D9" FontSize="13" Margin="0,0,0,7"/><TextBlock Text="关闭窗口后仍在托盘同步。&#10;右键托盘图标，可彻底退出。" Foreground="#7893A3" FontSize="11" LineHeight="19"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="38,34,38,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Heading" Text="全部清单" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><local:DateSelector x:Name="DateFilter" Width="144" Margin="12,0,10,0" SelectedDateChanged="DateFilter_Changed"/><Button Content="＋ 详细新建" Height="40" MinWidth="122" Margin="0" Padding="15,0" Click="New_Click" Background="#167D8D" Foreground="White"/></StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Subtitle" Foreground="#8A96A4" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="DeleteCompletedButton" Content="全部删除" Visibility="Collapsed" Height="32" Margin="10,0,0,0" Padding="12,0" Foreground="#B34E4E" Background="#F9ECEC" Click="DeleteCompleted_Click"/></Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ItemsPanel" Margin="0,0,8,0"/></ScrollViewer>
      <Border Grid.Row="3" Background="White" BorderBrush="#DCE5EC" BorderThickness="1" CornerRadius="16" Height="54" Padding="8,6,6,6" Margin="0,18,0,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid><TextBox x:Name="QuickInput" KeyDown="QuickInput_KeyDown" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" FontSize="16" MaxLength="500" Height="40" VerticalAlignment="Center" Margin="0" Padding="10,0"/><TextBlock Text="记下一个想法，按 Enter 添加…" Foreground="#9AA6B2" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=QuickInput}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=QuickInput}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <Button Grid.Column="1" Content="✓" FontWeight="Bold" AutomationProperties.Name="添加待办" FontSize="25" Width="40" Height="40" VerticalAlignment="Center" Margin="8,0,0,0" Padding="0" Background="#167D8D" Foreground="White" Click="QuickAdd_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" FontSize="11" Foreground="#8898A6"/><TextBlock Text="双击查看详情 · 右键完成或删除" FontSize="11" Foreground="#A2ADB7" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="↻ 手动同步" Height="36" Margin="12,0,0,0" Padding="12,0" Click="Sync_Click"/></Grid>
    </Grid>
  </Grid>
</Window>
