<Window x:Class="LanTodo.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LanTodo.Windows" Style="{StaticResource {x:Type Window}}" Title="LanTodo" Width="1120" Height="780" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#192F3C" Padding="20,30">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="10,0,0,16"><Image x:Name="BrandIcon" Source="{StaticResource BrandMark}" Width="44" Height="44" VerticalAlignment="Center" AutomationProperties.Name="LanTodo 图标"/><TextBlock x:Name="BrandTitle" Text="LanTodo" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="White" FontSize="23" FontWeight="SemiBold"/></StackPanel>
          <Button x:Name="AllButton" Content="☷     全部清单" Style="{StaticResource Nav}" Click="All_Click"/>
          <Button x:Name="DoneButton" Content="✓     已完成" Style="{StaticResource Nav}" Click="Done_Click"/>
          <Button x:Name="ConflictsButton" Content="◇     待确认" Style="{StaticResource Nav}" Click="Conflicts_Click"/>
          <Button x:Name="TrashButton" Content="▱     回收站" Style="{StaticResource Nav}" Click="Trash_Click"/>
          <Border Height="1" Background="#2D4351" Margin="16,12"/>
          <Button Content="⇄     设备与同步" Style="{StaticResource Nav}" Click="Devices_Click"/>
          <Button Content="▧     备份与恢复" Style="{StaticResource Nav}" Click="Backup_Click"/>
        </StackPanel>
        </ScrollViewer><Button Grid.Row="1" x:Name="SettingsButton" Content="⚙     设置" Style="{StaticResource Nav}" Click="Settings_Click"/>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="38,34,38,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="Heading" Text="全部清单" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ItemCount" Foreground="#8A96A4" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><local:DateSelector x:Name="DateFilter" Width="190" Margin="12,0,10,0" SelectedDateChanged="DateFilter_Changed"/><Button x:Name="NewButton" Content="＋ 详细新建" Height="40" MinWidth="122" Margin="0" Padding="15,0" Click="New_Click" Background="#167D8D" Foreground="White"/><Button x:Name="DeleteCompletedButton" Content="全部删除" Visibility="Collapsed" Height="40" MinWidth="122" Margin="10,0,0,0" Padding="12,0" Foreground="#B34E4E" Background="#F9ECEC" Click="DeleteCompleted_Click"/></StackPanel>
      </Grid>
      <StackPanel Grid.Row="1"><Grid Margin="0,0,0,12"><TextBox x:Name="SearchInput" Height="36" Margin="0" Padding="12,0" Background="White" TextChanged="Search_Changed" AutomationProperties.Name="搜索标题、备注与文件名"/><TextBlock Text="搜索标题、备注与文件名 · Ctrl+F" Foreground="#9AA6B2" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Grid Visibility="{Binding Visibility, ElementName=Subtitle}" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Subtitle" Foreground="#8A96A4" VerticalAlignment="Center"/></Grid></StackPanel>
      <local:MessageList x:Name="ListScroll" Grid.Row="2" Margin="0,0,8,0"/>
      <StackPanel Grid.Row="3" x:Name="Composer"><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="PendingPanel" Margin="0,8,0,0"/></ScrollViewer><Border Background="White" BorderBrush="#DCE5EC" BorderThickness="1" CornerRadius="16" MinHeight="54" Padding="8,6,6,6" Margin="0,18,0,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid><TextBox x:Name="QuickInput" KeyDown="QuickInput_KeyDown" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" FontSize="16" MaxLength="500" MinHeight="40" MaxHeight="112" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center" Margin="0" Padding="10,0"/><TextBlock Text="记下一个想法，Enter 添加 · Shift+Enter 换行" Foreground="#9AA6B2" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=QuickInput}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=QuickInput}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AttachButton" Width="32" Height="32" VerticalAlignment="Center" Padding="0" Margin="4,0" Click="Attach_Click" AutomationProperties.Name="添加图片、文件或文件夹"><Path Data="M 0,6 L 12,6 M 6,0 L 6,12" Stroke="#167D8D" StrokeThickness="1.8" Width="12" Height="12"/></Button><Button Content="✓" FontWeight="Bold" AutomationProperties.Name="添加待办" FontSize="25" Width="40" Height="40" VerticalAlignment="Center" Margin="8,0,0,0" Padding="0" Background="#167D8D" Foreground="White" Click="QuickAdd_Click"/></StackPanel>
        </Grid>
      </Border></StackPanel>
      <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" FontSize="11" Foreground="#8898A6"/><Button x:Name="UndoButton" Content="已移到回收站 · 撤销" Visibility="Collapsed" HorizontalAlignment="Left" Padding="10,6" Margin="0,5,0,0" Click="Undo_Click"/></StackPanel><Button Grid.Column="1" Content="↻ 手动同步" Height="36" Margin="12,0,0,0" Padding="12,0" Click="Sync_Click"/></Grid>
    </Grid>
  </Grid>
</Window>
